NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acadence
# Optional direct/session-pooler URL used only by the migration command.
MIGRATION_DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# One or more exact frontend origins, separated by commas.
FRONTEND_URLS=http://localhost:5173

# Generate a unique random value of at least 32 characters. Never commit it.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h

# Shared only with the person authorized to provision administrator accounts.
ADMIN_REGISTRATION_SECRET=replace-with-a-long-random-secret
